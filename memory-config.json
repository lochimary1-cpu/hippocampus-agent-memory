{
  "_comment": "Memory Management System Configuration — human-like memory lifecycle",
  "_version": "1.0.0",
  "_created": "2026-07-29",

  "scoring": {
    "weights": {
      "generality": 0.25,
      "actionability": 0.25,
      "durability": 0.20,
      "novelty": 0.15,
      "specificity": 0.15
    },
    "thresholds": {
      "promote": 70,
      "archive": 50,
      "discard": 0,
      "retirement_decay": 30
    },
    "overrides": {
      "user_explicit_remember": 100,
      "user_feedback_min": 70,
      "multi_session_auto_promote": 3
    }
  },

  "compression": {
    "target_ratio": 3.0,
    "triggers": {
      "deduplication": { "entries_per_category": 10 },
      "abstraction": { "entries_per_category": 15, "min_similar": 3 },
      "reorganization": { "entries_per_category": 25, "weekly": true }
    },
    "similarity": {
      "jaccard_threshold": 0.7,
      "shared_tags_min": 2
    }
  },

  "consolidation": {
    "interval_sessions": 10,
    "unreferenced_decay_days": 30,
    "age_decay_lambda": 0.01,
    "type_half_lives": {
      "preference": 180,
      "decision": 90,
      "pattern": 120,
      "lesson": 60,
      "reference": 30,
      "feedback": 30
    }
  },

  "retrieval": {
    "relevance_weights": {
      "tag_match": 0.6,
      "recency": 0.3,
      "quality": 0.1
    },
    "category_diversity_max": 3
  },

  "token_budget": {
    "indices_max": 500,
    "content_per_load_max": 2000,
    "session_journal_max": 3000,
    "global_total_max": 25000,
    "per_project_total_max": 15000,
    "per_memory_file_max": {
      "preferences": 1500,
      "patterns": 2000,
      "lessons_global": 3000,
      "lessons_project": 2000,
      "architecture": 1500,
      "goals": 500,
      "reference": 1500,
      "status": 800
    },
    "roi_target": 3.0
  },

  "session": {
    "auto_capture_interval_minutes": 30,
    "summary_retention_days": 30,
    "archive_retention_days": 90,
    "purge_after_days": 365
  }
}
